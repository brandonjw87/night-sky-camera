        android:icon="@drawable/ic_sc_stack"
        android:shortcutId="stack5"
        android:shortcutLongLabel="@string/sc_stack5_long"
        android:shortcutShortLabel="@string/sc_stack5_short">
        <intent
            android:action="com.brandon.nightsky.LAUNCH"
            android:data="nightsky://launch/stack5"
            android:targetClass="com.brandon.nightsky.MainActivity"
            android:targetPackage="com.brandon.nightsky" />
