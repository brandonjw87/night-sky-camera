<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon (E3). Each opens the app and starts with these settings: lay the phone down. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
